{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hendry-commercial",
  "main": "beta-worker.js",
  "assets": {
    "directory": "casey-beta",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-09-25",
  "ai": {
    "binding": "AI"
  },
  "vars": { "CASEY_BETA_ENABLED": "false" },
  "previews": {
    "ai": { "binding": "AI" },
    "vars": { "CASEY_BETA_ENABLED": "false" }
  }
}
