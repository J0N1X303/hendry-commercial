{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hendry-commercial",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/cara",
      "/cara/*",
      "/api/cara-prep",
      "/api/cara-prep/*",
      "/api/buyer-readiness-check"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  },
  "main": "worker.js"
}
