{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hendry-commercial",
  "main": "beta-worker.js",
  "assets": {
    "directory": "casey-beta",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_date": "2026-09-25",
  "ai": {
    "binding": "AI"
  },
  "vars": { "CASEY_BETA_ENABLED": "false" },
  "previews": {
    "ai": { "binding": "AI" },
    "d1_databases": [{
      "binding": "CASEY_BETA_DB",
      "database_name": "casey-beta",
      "database_id": "ede992d4-2687-44ff-be3b-032d8ea3e88d",
      "migrations_dir": "migrations/casey-beta"
    }],
    "vars": { "CASEY_BETA_ENABLED": "false" }
  }
}